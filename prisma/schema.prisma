generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Note {
  id          String       @id
  title       String       @default("Untitled")
  content     String       @default("")
  cover       String?
  pinned      Boolean      @default(false)
  folderId    String?
  tags        String       @default("[]") // JSON array of tag strings
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([folderId])
  @@index([updatedAt])
}

model Folder {
  id        String   @id
  name      String
  icon      String   @default("folder")
  color     String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  notes     Note[]
}

model Canvas {
  id        String   @id
  name      String   @default("Untitled board")
  data      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pet {
  id        String   @id
  name      String   @default("Mochi")
  species   String   @default("cat")
  food      Int      @default(80)
  energy    Int      @default(90)
  joy       Int      @default(70)
  xp        Int      @default(0)
  coins     Int      @default(120)
  hat       String   @default("none")
  owned     String   @default("[\"none\"]")
  tricks    String   @default("[]")
  stats     String   @default("{}")
  look      String   @default("{}") // active palette override { ramp?, accent? } from the pet library
  tickAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

/** a bug report filed from the in-app reporter — logs, page and UA ride along */
model Bug {
  id         String   @id
  desc       String
  severity   String   @default("minor") // minor | normal | blocker
  page       String   @default("")
  ua         String   @default("")
  logs       String   @default("")
  screenshot String   @default("") // base64 jpeg data-url attached by the reporter
  status     String   @default("open") // open | fixing | fixed
  createdAt  DateTime @default(now())
}

/** a folder in the pet library, e.g. "dog" -> /pet/dog — groups pet blueprints */
model PetFolder {
  id         String         @id
  name       String
  position   Int            @default(0)
  createdAt  DateTime       @default(now())
  blueprints PetBlueprint[]
}

/** one saveable pet design — pick it to become your active companion; import/export as JSON */
model PetBlueprint {
  id        String     @id
  folderId  String?
  name      String
  species   String // base shape (cat/dog/…)
  look      String     @default("{}") // { ramp?, accent?, says?, blurb? }
  origin    String     @default("custom") // builtin | custom | imported
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  folder    PetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
}

model Listing {
  id        String         @id
  kind      String
  itemId    String
  name      String
  blurb     String         @default("")
  price     Int
  seller    String         @default("Nook Team")
  payload   String         @default("{}")
  sold      Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    ListingEvent[]

  @@index([sold])
}

/**
 * price timeline for a listing: listed → reprice… → sold (feeds market sparklines)
 */
model ListingEvent {
  id        String   @id
  listingId String
  price     Int
  kind      String // "list" | "reprice" | "sold"
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Achievement {
  id        String   @id
  key       String   @unique
  title     String
  desc      String   @default("")
  icon      String   @default("star")
  createdAt DateTime @default(now())
}

/**
 * one todo/task — lives in the Tasks tab, can be created by the user or the AI harness
 */
model Task {
  id          String    @id
  title       String
  list        String    @default("today") // today | upcoming | someday
  priority    Int       @default(1) // 0 low · 1 normal · 2 high
  due         BigInt? // epoch ms due date (BigInt — Int32 overflows on read-back)
  done        Boolean   @default(false)
  noteId      String? // optional link back to a note
  tags        String    @default("[]") // JSON array of tag strings
  by          String    @default("you") // you | ai | agent
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

/**
 * app-usage buckets (TimeLens-style tracking). One row per (app, day, src).
 * secs accumulates via upsert-increments from the web tracker, manual entries and external agents.
 */
model AppUse {
  id        String   @id
  app       String
  cat       String   @default("neutral") // productive | neutral | distraction
  day       String // YYYY-MM-DD
  secs      Int      @default(0)
  src       String   @default("web") // web | manual | agent
  updatedAt DateTime @updatedAt

  @@unique([app, day, src])
  @@index([day])
}

/**
 * a file attached to a note — images render inline in the editor, files are downloadable.
 * bytes live base64-encoded in `data` (fine for a local SQLite vault: keep files small).
 */
model Attachment {
  id        String   @id
  noteId    String
  name      String
  mime      String   @default("application/octet-stream")
  size      Int      @default(0) // bytes
  data      String   @default("") // base64 payload
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

/** simple key/value store — currently holds the activity rules JSON so the AI harness can manage them too */
model Setting {
  id        String   @id
  value     String   @default("{}")
  updatedAt DateTime @updatedAt
}
