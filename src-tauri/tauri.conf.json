{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nook",
  "version": "1.0.0",
  "identifier": "com.realhackers.nook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nook",
        "url": "index.html",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:* ws: wss: https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net",
        "worker-src": "'self' blob:"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Pixel-art AI notes super app",
    "longDescription": "Nook — a soft, pixel-flavoured second brain: markdown notes, graph, canvas, tasks, focus timer, arcade, a desktop pet, AI agent and an MCP server.",
    "publisher": "Team RealHackers",
    "copyright": "© 2026 Team RealHackers",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "wix": { "language": "en-US" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["nook"] }
    }
  }
}
