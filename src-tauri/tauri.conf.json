{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nook",
  "version": "0.10.0",
  "identifier": "com.mrreal.nook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nook",
        "width": 1200,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "A cozy little notes desk — 100% local, offline-first",
    "longDescription": "Nook is a real, native desktop notes app. Notes, folders and tasks live in a local SQLite database on your PC. No servers, no accounts, no internet required.",
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
